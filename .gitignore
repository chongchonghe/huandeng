/extern/

.venv/
__pycache__/
.DS_Store

# editor scratch
*.swp
*.swo
*~

# Build outputs. Reproducible, so there is nothing to preserve:
#   uv run python tools/build-slides.py <deck>
out/

# Quarto's own cache, and a stray in-place render: `quarto render <file>` writes
# beside the source and ignores output-dir, where a bare `quarto render` does not.
#
# fonts.html, guides.html and theme.scss are SOURCE, not output. The globs below
# exist for stray renders and will happily eat a source file that shares their
# suffix — which is exactly what happened to guides.html once, unnoticed for
# several commits, because the working tree still had it. Add a negation for any
# new source file whose extension collides.
.quarto/
/demo/*.html
/themes/*/*.html
!/demo/fonts.html
!/themes/*/fonts.html
!/demo/guides.html
!/themes/*/guides.html
/demo/*.pdf
/themes/*/*.pdf
/demo/*.pptx
/themes/*/*.pptx
/demo/*_files/
/themes/*/*_files/

# Dead ends kept for reference. The README there says how to regenerate them,
# which is worth committing; the artefacts themselves are not.
/trash/*
!/trash/README.md
!/trash/*.py

# Your own decks. The folder is tracked so it is there after a clone; everything
# you put in it is not, so your talks never become part of this repository and
# `git pull` never conflicts with your work.
/talks/*
!/talks/README.md
